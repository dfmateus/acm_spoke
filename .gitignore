# =============================================================================
# SECURITY RULES AND IGNORED FILES - ANSIBLE ACM SPOKE
# =============================================================================

# Local-only credentials and scratch files (never committed)
.local/

# Local environment scripts and credentials (REQUIRED)
env-setup.sh
*env*.sh
*.env
.env*

# Ansible Vault files and secrets
*vault*
secrets.yml
vars/secrets.yml

# Private keys, certificates and access tokens
*.pem
*.key
*.crt
*.id_rsa

# Python artifacts and locally downloaded Ansible collections
__pycache__/
*.pyc
.collections/
.python_history

# Execution cache and temporary state
.ansible/
roles/*/.ansible/
.retry
*.retry
*.log
.kube/

# Collection build artifacts (ansible-galaxy collection build output)
*.tar.gz

# Execution Environment build artifacts (generated by ansible-builder)
context/

# Claude Code IDE configuration (local dev only; not collection content)
.claude/
CLAUDE.md
.agents/

# Cursor IDE configuration (local dev only)
.cursor/

# Claude Code project MCP config (contains lab token; gitignored)
.mcp.json

# Scratch and temp directories
tmp/
